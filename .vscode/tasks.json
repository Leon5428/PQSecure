{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PQSecure: configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_CXX_COMPILER=g++"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "PQSecure: build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build"],
            "dependsOn": ["PQSecure: configure"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}

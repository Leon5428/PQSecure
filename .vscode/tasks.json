{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PQSecure: configure",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
                "-DCMAKE_PREFIX_PATH=C:/msys64/ucrt64"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
            },
            "problemMatcher": []
        },
        {
            "label": "PQSecure: build",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/cmake.exe",
            "args": ["--build", "${workspaceFolder}/build", "--target", "ml_kem_768_demo"],
            "dependsOn": ["PQSecure: configure"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
